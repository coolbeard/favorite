{
  "name": "cloudnav",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "基于 Cloudflare 生态的现代化导航",
  "author": "coolbeard",
  "license": "MIT",
  "homepage": "https://github.com/coolbeard/favorite",
  "repository": {
    "type": "git",
    "url": "https://github.com/coolbeard/favorite.git"
  },
  "bugs": {
    "url": "https://github.com/coolbeard/favorite/issues"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "d": "bunx wrangler pages dev ./dist --kv CLOUDNAV_KV",
    "k": "bunx knip",
    "types": "bunx wrangler types --path ./functions/types.d.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md,json}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@edgeone/pages-blob": "^0.0.8",
    "@google/genai": "^1.52.0",
    "buffer": "^6.0.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
